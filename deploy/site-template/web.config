<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <defaultDocument><files><clear/><add value="index.html"/></files></defaultDocument>
    <directoryBrowse enabled="false"/>
    <staticContent>
      <remove fileExtension=".application"/><mimeMap fileExtension=".application" mimeType="application/x-ms-application"/>
      <remove fileExtension=".manifest"/><mimeMap fileExtension=".manifest" mimeType="application/x-ms-manifest"/>
      <remove fileExtension=".deploy"/><mimeMap fileExtension=".deploy" mimeType="application/octet-stream"/>
      <clientCache cacheControlMode="DisableCache"/>
    </staticContent>
    <httpProtocol><customHeaders><remove name="X-Content-Type-Options"/><add name="X-Content-Type-Options" value="nosniff"/></customHeaders></httpProtocol>
    <security><requestFiltering>
      <fileExtensions allowUnlisted="false"><clear/>
        <add fileExtension="." allowed="true"/>
        <add fileExtension=".html" allowed="true"/><add fileExtension=".application" allowed="true"/>
        <add fileExtension=".manifest" allowed="true"/><add fileExtension=".deploy" allowed="true"/>
      </fileExtensions>
      <hiddenSegments><add segment=".mousetrail-site.json"/></hiddenSegments>
    </requestFiltering></security>
  </system.webServer>
</configuration>
